# Supabase database and Storage server configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Public site metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Gemini configuration. No AI calls are made by auth/workspace setup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Default 20 MB; maximum supported by the private storage bucket is 50 MB.
DOCUMENT_MAX_FILE_SIZE_MB=20
