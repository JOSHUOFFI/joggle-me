# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public application origin used for authentication redirects and social metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never expose this to browser code or NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Gemini configuration. Use a development key with suitable API limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Default 20 MB; maximum supported by the private storage bucket is 50 MB.
DOCUMENT_MAX_FILE_SIZE_MB=20

# Optional operator-supplied bootstrap. Used only by the secure provisioning script.
INITIAL_OWNER_USER_ID=
